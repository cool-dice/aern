model Guild {
  id                String             @id @db.Uuid
  name              String             @unique
  tag               String
  leaderId          String             @map("leader_id") @db.Uuid
  createdAt         DateTime           @map("created_at") @db.Timestamptz(6)
  doctrine          String?
  doctrineChangedAt DateTime?          @map("doctrine_changed_at") @db.Timestamptz(6)
  taxRate           Int                @map("tax_rate")
