  members           GuildMember[]
  cachedCharacters  Character[]        @relation("CharacterGuildCache")
  titles            CharacterTitle[]
  ownedNodes        Node[]
  ownedResources    ResourceNode[]
  controlledNodes   GuildNodeControl[]
  bank              GuildBank?
  warsAttacked      GuildWar[]         @relation("WarAttacker")
  warsDefended      GuildWar[]         @relation("WarDefender")
  warsWon           GuildWar[]         @relation("WarWinner")
  diplomacyAsA      GuildDiplomacy[]   @relation("DiplomacyA")
  diplomacyAsB      GuildDiplomacy[]   @relation("DiplomacyB")

  @@index([leaderId])
  @@map("guilds")
}

